.game-container {
  background-color: white;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.title {
  color: #2196F3;
  margin-bottom: 30rpx;
  font-size: 44rpx;
  font-weight: bold;
}

.mode-switch {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.mode-button {
  background-color: #e3f2fd;
  color: #2196F3;
  border: none;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 1.2;
}

.mode-button.active {
  background-color: #2196F3;
  color: white;
}

.question-settings {
  margin-bottom: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.question-settings .input {
  width: 100rpx;
  border: 1rpx solid #ccc;
  border-radius: 8rpx;
  margin-left: 10rpx;
  padding: 4rpx;
  text-align: center;
}

.game-info {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.info-badge {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background-color: #e3f2fd;
  color: #2196F3;
  font-weight: bold;
  font-size: 24rpx;
}

.status {
  min-height: 40rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background-color: #f9f9f9;
  color: #555;
  font-weight: bold;
  font-size: 26rpx;
  margin-bottom: 30rpx;
}

.question-area {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.question-area .label {
  font-size: 32rpx;
  font-weight: bold;
  color: #555;
}

.question-text {
  font-size: 48rpx;
  font-weight: bold;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background-color: #fff3e0;
  color: #ff9800;
  border-left: 8rpx solid #ff9800;
}

.input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.pinyin-input {
  width: 80%;
  padding: 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid #ccc;
  font-size: 32rpx;
  text-align: center;
}

.btn {
  background-color: #2196F3;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 1.5;
}

.submit-btn {
  background-color: #4CAF50;
  width: 60%;
}

/* 键盘样式 */
.keyboard {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  width: 100%;
}

.keyboard-row {
  display: flex;
  gap: 8rpx;
}

.key-button {
  min-width: 50rpx;
  padding: 16rpx 10rpx;
  border-radius: 8rpx;
  background-color: #e0e0e0;
  color: #333;
  border: none;
  font-weight: bold;
  font-size: 24rpx;
  line-height: 1;
}

.key-button.wide {
  min-width: 100rpx;
}

/* 选项样式 */
.options-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.option-button {
  font-size: 32rpx;
  background-color: #2196F3;
  color: white;
  padding: 24rpx 0;
  border-radius: 10rpx;
  font-weight: bold;
  line-height: 1.5;
}

.option-button.correct {
  background-color: #4CAF50;
}

.option-button.wrong {
  background-color: #f44336;
}

.control-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.next-btn {
  background-color: #ff9800;
}

.back-btn {
  background-color: #2196F3;
}
