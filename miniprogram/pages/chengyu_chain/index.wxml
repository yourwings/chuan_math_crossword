<view class="container">
  <view class="game-container">
    <view class="title">成语接龙</view>
    
    <view class="controls-row" wx:if="{{!gameStarted}}">
      <view class="setting-item">
        <text class="label">接龙数目：</text>
        <input class="input" type="number" value="{{targetRounds}}" bindinput="onTargetRoundsInput" />
      </view>
      <button class="btn start-btn" bindtap="startGame">开始游戏</button>
    </view>
    
    <view class="controls-row" wx:if="{{gameStarted}}">
      <button class="btn restart-btn" bindtap="restartGame">重新开始</button>
      <button class="btn back-btn" bindtap="goBack">返回首页</button>
    </view>

    <view class="game-info" wx:if="{{gameStarted}}">
      <view class="info-badge">第 {{currentRound}} / {{targetRounds}} 题</view>
      <view class="info-badge">已答对: {{correctCount}}</view>
    </view>

    <view class="status">{{status}}</view>

    <view class="question-area" wx:if="{{gameStarted}}">
      <view class="label">当前成语：</view>
      <view class="current-idiom">{{currentIdiom}}</view>
    </view>

    <view class="options-container" wx:if="{{gameStarted}}">
      <button 
        wx:for="{{options}}" 
        wx:key="*this" 
        class="option-button {{item.class}}" 
        disabled="{{item.disabled}}"
        bindtap="onOptionClick" 
        data-idiom="{{item.text}}"
      >
        {{item.text}}
      </button>
    </view>

    <view class="game-instructions" wx:if="{{!gameStarted}}">
      <view class="instructions-title">玩法说明：</view>
      <view class="instruction-item">• 从四个候选成语中选择一个，使首字与上一个成语的尾字相同。</view>
      <view class="instruction-item">• 每次答题有两次机会，第二次答错则挑战结束。</view>
      <view class="instruction-item">• 目标是完成预设数量的接龙，加油！</view>
    </view>
  </view>

  <!-- 游戏结束弹窗 -->
  <view class="modal" wx:if="{{showGameOver}}">
    <view class="modal-content">
      <view class="modal-title">游戏结束</view>
      <view class="game-result">
        <view>目标接龙数目：{{targetRounds}}</view>
        <view>实际答对数目：{{correctCount}}</view>
        <view class="result-msg">{{resultMsg}}</view>
      </view>
      <view class="modal-buttons">
        <button class="btn play-again-btn" bindtap="restartGame">再玩一次</button>
        <button class="btn return-home-btn" bindtap="goBack">返回首页</button>
      </view>
    </view>
  </view>
</view>
