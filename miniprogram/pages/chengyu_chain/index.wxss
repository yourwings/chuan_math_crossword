.game-container {
  background-color: white;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  padding: 50rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.title {
  color: #2196F3;
  margin-bottom: 40rpx;
  font-size: 48rpx;
  font-weight: bold;
}

.controls-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  flex-wrap: wrap;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-item .label {
  font-weight: bold;
  color: #555;
  font-size: 28rpx;
}

.setting-item .input {
  width: 180rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid #ccc;
  text-align: center;
  font-size: 28rpx;
}

.btn {
  background-color: #2196F3;
  color: white;
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 1.5;
  margin: 0;
}

.start-btn {
  background-color: #4CAF50;
}

.restart-btn {
  background-color: #ff9800;
}

.back-btn {
  background-color: #2196F3;
}

.game-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  flex-wrap: wrap;
}

.info-badge {
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  background-color: #e3f2fd;
  color: #2196F3;
  font-weight: bold;
  font-size: 28rpx;
  min-width: 240rpx;
}

.status {
  min-height: 48rpx;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  background-color: #e8f5e9;
  color: #4CAF50;
  font-weight: bold;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.question-area {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  flex-wrap: wrap;
}

.question-area .label {
  font-size: 36rpx;
  font-weight: bold;
  color: #555;
}

.current-idiom {
  font-size: 48rpx;
  font-weight: bold;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  background-color: #fff3e0;
  color: #ff9800;
  border-left: 8rpx solid #ff9800;
}

.options-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.option-button {
  font-size: 36rpx;
  background-color: #2196F3;
  color: white;
  border: none;
  padding: 30rpx 0;
  border-radius: 10rpx;
  font-weight: bold;
  line-height: 1.5;
}

.option-button.correct {
  background-color: #4CAF50;
}

.option-button.wrong {
  background-color: #f44336;
}

.game-instructions {
  margin-top: 40rpx;
  text-align: left;
  background-color: #f9f9f9;
  padding: 30rpx;
  border-radius: 16rpx;
  line-height: 1.6;
  color: #555;
  font-size: 26rpx;
}

.instructions-title {
  font-weight: bold;
  margin-bottom: 10rpx;
}

.instruction-item {
  margin-bottom: 6rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background-color: white;
  padding: 60rpx;
  border-radius: 20rpx;
  text-align: center;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  color: #2196F3;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.game-result {
  margin-bottom: 40rpx;
  line-height: 1.8;
  font-size: 32rpx;
  color: #333;
}

.result-msg {
  font-weight: bold;
  color: #ff9800;
  margin-top: 20rpx;
}

.modal-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.play-again-btn {
  background-color: #4CAF50;
}

.return-home-btn {
  background-color: #2196F3;
}
