.games-container {
  background-color: white;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  padding: 50rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.title {
  color: #2196F3;
  margin-bottom: 40rpx;
  font-size: 50rpx;
  font-weight: bold;
}

.games-description {
  margin-bottom: 60rpx;
  color: #555;
  line-height: 1.6;
  font-size: 28rpx;
}

.games-grid {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.game-card {
  background-color: #f8f9fa;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.game-name {
  color: #2196F3;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.game-desc {
  color: #666;
  margin-bottom: 30rpx;
  font-size: 24rpx;
}

.play-button {
  background-color: #4CAF50;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  font-weight: bold;
  font-size: 28rpx;
  display: inline-block;
  line-height: 1.5;
}

.coming-soon {
  opacity: 0.6;
}

.coming-soon::after {
  content: "即将重构";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  font-weight: bold;
  font-size: 24rpx;
  z-index: 10;
}
